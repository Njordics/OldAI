set timeout=@TIMEOUT@
set default=0
loadfont unicode

set menu_color_normal=white/black
set menu_color_highlight=black/light-gray

menuentry "Install AI Cluster @TITLE@ (ERASES the largest disk)" {
	set gfxpayload=keep
	linux	/casper/vmlinuz autoinstall @KERNEL_ARGS@ ---
	initrd	/casper/initrd
}
menuentry "Boot from the next device (do not install)" {
	exit 1
}
grub_platform
if [ "$grub_platform" = "efi" ]; then
menuentry "UEFI firmware settings" {
	fwsetup
}
fi
