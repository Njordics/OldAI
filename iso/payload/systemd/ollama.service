[Unit]
Description=Ollama runtime (AI Cluster, loopback only)
After=network-online.target

[Service]
User=ollama
Group=ollama
# Loopback only: clients reach models through the Controller's gateway, and
# pulls come from the agent's registry shim on 127.0.0.1:7452.
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=/var/lib/aicluster/models/ollama
Environment=OLLAMA_NUM_PARALLEL=4
EnvironmentFile=-/etc/aicluster/ollama.env
ExecStart=/usr/bin/ollama serve
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
