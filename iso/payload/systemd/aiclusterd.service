[Unit]
Description=AI Cluster Controller
Documentation=https://github.com/Njordics/OldAI
Wants=network-online.target aicluster-provisioner.service
After=network-online.target aicluster-provisioner.service

[Service]
User=aicluster
Group=aicluster
StateDirectory=aicluster
StateDirectoryMode=0750
EnvironmentFile=-/etc/aicluster/controller.env
ExecStart=/usr/bin/aiclusterd $AICLUSTERD_ARGS
# Slave network: add its address, serve DHCP (port 67, bound to the
# interface) and DNS (port 53). Nothing else runs privileged.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/aicluster /run/aicluster

[Install]
WantedBy=multi-user.target
